<Window x:Class="Bot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bot" Height="700" Width="720" MinHeight="580" MinWidth="600">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Bot" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <GroupBox Header="Configuración" Padding="12"><StackPanel>
   <TextBlock Text="URL de la API (HTTPS)"/><TextBox x:Name="Api" Margin="0,4,0,10"/>
   <TextBlock Text="ID del agente"/><TextBox x:Name="AgentId" Margin="0,4,0,10"/>
   <TextBlock Text="Secreto del agente"/><PasswordBox x:Name="Secret" Margin="0,4,0,10"/>
   <StackPanel Orientation="Horizontal"><Button Content="Probar conexión" Click="TestConnection" Padding="12,6" Margin="0,0,8,0"/><Button Content="Guardar configuración" Click="SaveSettings" Padding="12,6"/></StackPanel>
  </StackPanel></GroupBox>
  <GroupBox Header="Estado" Padding="12" Margin="0,16,0,0"><StackPanel>
   <TextBlock x:Name="Connection" Text="Conexión: sin comprobar" TextWrapping="Wrap"/>
   <TextBlock x:Name="LastContact" Text="Última comunicación: —" Margin="0,6,0,0"/>
   <TextBlock x:Name="AgentStatus" Text="Agente: detenido" Margin="0,6,0,0"/>
   <TextBlock x:Name="CurrentWork" Text="Trabajo y progreso: sin actividad" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="LastRun" Text="Última ejecución: —" Margin="0,6,0,0"/>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="StartButton" Content="Iniciar" Click="Start" Padding="16,6" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="Detener" Click="Stop" Padding="16,6" IsEnabled="False"/></StackPanel>
  </StackPanel></GroupBox>
  <TextBlock Text="Actividad y errores recientes" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBox x:Name="Log" IsReadOnly="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 </StackPanel></ScrollViewer>
</Window>
