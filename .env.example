# Variables que deben configurarse en Environment de Dokploy para este Compose.
# Sustituya los valores de ejemplo. No suba un .env real al repositorio.
FRONTEND_ORIGIN=https://app.midominio.com
SRI_ADMIN_USERNAME=admin
SRI_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_UNICA_DE_AL_MENOS_16_CARACTERES

# Directorios absolutos existentes en el host de Dokploy.
# SRI_CONFIG_DIR debe contener sri-portal.json, con permisos de lectura y escritura.
# SRI_SECRET_DIR debe contener agent.key, credential.key y session.key.
SRI_CONFIG_DIR=/srv/botsopa/config
SRI_SECRET_DIR=/srv/botsopa/secrets

# false activa el procesamiento. true inicia el worker sin procesar trabajos.
SRI_WORKER_PAUSED=true

# Los siguientes valores de la API y del worker los configura compose.dokploy.yml:
# ASPNETCORE_ENVIRONMENT=Production
# SRI_COOKIE_SECURE=true
# Cors__AllowedOrigins__0 se obtiene de FRONTEND_ORIGIN
# SRI_STATE_PATH=/app/storage
# SRI_OUTPUT_PATH=/app/downloads
# SRI_SESSION_PATH=/app/sessions
# SRI_CREDENTIAL_PATH=/app/credentials (API)
# SRI_PORTAL_PROFILE=/app/config/sri-portal.json
# SRI_AGENT_KEY_FILE=/run/secrets/agent-key (API)
# SRI_CREDENTIAL_KEY_FILE=/run/secrets/credential-key (API)
# SRI_SESSION_KEY_FILE=/run/secrets/session-key (worker)
